          "settings": {
            "column": "col_1",
            "visibility": "always-display",
            "heading": "<em>Hydration Made Simple. Adventures Made Better.</em>",
            "title_highlight_color": "#6d388b",
            "heading_size": "h1",
            "alignment": "center",
            "mobile_alignment": "mobile-center",
            "margin_top": 20,
            "margin_bottom": 20
          }
        },
        "template--21507361800487__8beb6911-28c6-482c-976a-e5421ad3e8df-richtext-1": {
          "type": "richtext",
          "settings": {
            "column": "col_1",
            "visibility": "always-display",
            "text": "<p>Built around one idea: your dog should never have to wait for water. One bottle, one bowl, zero excuses — designed for real walks, real adventures, and real dogs.</p>",
            "text_style": "body",
            "alignment": "center",
            "mobile_alignment": "mobile-center",
            "margin_top": 20,
            "margin_bottom": 20
          }
        },
        "template--21507361800487__8beb6911-28c6-482c-976a-e5421ad3e8df-icon_with_text-1": {
          "type": "icon_with_text",
          "settings": {
            "column": "col_2",
            "visibility": "always-display",
            "icon": "[UIImage imageNamed:@\"water_drops\"]",
            "filled_icon": false,
            "image": "shopify://shop_images/water_bottle_24dp_57C4D8_FILL0_wght400_GRAD0_opsz24.svg",
            "icon_size": "m",
            "icon_position": "next-to-title",
            "icon_color": "custom",
            "icon_heading_size": "h3",
            "icon_text_alignment": "left",
            "title": "Stainless Steel 10 Oz Bottle",
            "text": "<p>304 food-grade stainless steel holds both hot and cold water safely</p>",
            "margin_top": 20,
            "margin_bottom": 30
          }
        },
        "template--21507361800487__8beb6911-28c6-482c-976a-e5421ad3e8df-icon_with_text-2": {
          "type": "icon_with_text",
          "settings": {
