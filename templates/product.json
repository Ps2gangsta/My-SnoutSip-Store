            "icon_color": "accent-1",
            "icon_heading_size": "h3",
            "icon_text_alignment": "left",
            "title": "Foldable Bowl",
            "text": "<p>Built-in collapsible bowl means no extra gear — just flip, fill, and let them drink</p>",
